# PLUTON Phase 3 Environment Configuration

# Application
APP_NAME=PLUTON
APP_VERSION=3.0.0
DEBUG=False
LOG_LEVEL=INFO

# Database
DATABASE_URL=postgresql://pluton_user:pluton_password@db:5432/pluton_db
DATABASE_ECHO=False
DATABASE_POOL_SIZE=20

# FastAPI
FAST_API_HOST=0.0.0.0
FAST_API_PORT=8000
FAST_API_RELOAD=True

# Frontend (Next.js)
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_APP_NAME=PLUTON

# Sync Engine (Phase 3)
SYNC_ENGINE_ENABLED=True
SYNC_QUEUE_SIZE=1000
SYNC_BATCH_SIZE=50

# Security
SECRET_KEY=your-secret-key-here-change-in-production
ALLOWED_HOSTS=localhost,127.0.0.1,api.pluton.local

# CORS
CORS_ORIGINS=["http://localhost:3000", "http://localhost:8000"]

# Email (optional)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password

# Redis (optional, for caching)
REDIS_URL=redis://redis:6379/0

# JWT
JWT_ALGORITHM=HS256
JWT_EXPIRATION_HOURS=24
