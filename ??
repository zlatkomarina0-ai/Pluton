"""Tests for Phase 3 Sync Engine"""

import pytest

from app.phase3.sync_engine import SyncEngine


@pytest.fixture
def sync_engine() -> SyncEngine:
    return SyncEngine("postgresql://test:test@localhost:5432/pluton_test")


@pytest.mark.asyncio
async def test_sync_entity_basic(sync_engine: SyncEngine):
    """Test basic entity sync"""
    result = await sync_engine.sync_entity(
        entity_type="fixture",
        entity_id=1,
        data={"status": "scheduled", "date": "2026-10-15"},
    )
    assert result is True
    assert sync_engine.sync_queue.qsize() >= 1


@pytest.mark.asyncio
async def test_process_sync_queue(sync_engine: SyncEngine):
    """Test processing queued sync events."""
    await sync_engine.sync_entity("team", 5, {"name": "Test Team"})
    processed = await sync_engine.process_sync_queue()
    assert len(processed) >= 1
    assert all(item["status"] == "processed" for item in processed)


@pytest.mark.asyncio
async def test_sync_status_snapshot(sync_engine: SyncEngine):
    """Test sync status endpoint payload is JSON-safe."""
    await sync_engine.sync_entity("league", 7, {"name": "Premier League"})
    status = await sync_engine.get_status()
    assert status["queue_size"] >= 1
    assert status["active_syncs"] >= 1
    assert isinstance(status["events"], list)


@pytest.mark.asyncio
async def test_queue_sync_helper(sync_engine: SyncEngine):
    """Test queue_sync convenience wrapper."""
    response = await sync_engine.queue_sync("player", 99, {"name": "Test Player"})
    assert response["status"] == "queued"
    assert response["entity_type"] == "player"
    assert response["entity_id"] == 99


__all__ = ["sync_engine"]


# This keeps the module importable and test-friendly for pytest collection.
if __name__ == "__main__":
    import asyncio

    async def _self_test() -> None:
        engine = SyncEngine("postgresql://test:test@localhost:5432/pluton_test")
        await engine.sync_entity("fixture", 1, {"status": "scheduled"})
        print(await engine.get_status())

    asyncio.run(_self_test())


